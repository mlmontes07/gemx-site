# gemX Website (ulthra-website) Docker Environment Configuration

# Host HTTP port mapped to container Nginx port 80
# Defaults to 8383 so it can run side-by-side with ulthra-mezzio (8282) without port conflicts.
PORT=8383

# Host bind address in docker-compose.server.yml
# Use 127.0.0.1 when running behind Host Nginx reverse proxy (recommended), or 0.0.0.0 when exposing directly.
BIND_ADDR=0.0.0.0

# Optional Vite dev-container port (when using: docker compose --profile dev up)
DEV_PORT=4321

# Public domain used by ./docker/setup-nginx-proxy.sh
DOMAIN=gemx.online

