# gemX Website (ulthra-website) Environment Configuration

# Host HTTP port mapped to container Nginx port 80
# Defaults to 8383 so it can run side-by-side with ulthra-mezzio (8282) without port conflicts.
PORT=8383

# Host bind address in docker-compose.server.yml
# Use 127.0.0.1 when running behind Host Nginx reverse proxy (recommended), or 0.0.0.0 when exposing directly.
BIND_ADDR=0.0.0.0

# Optional Vite dev-container port (when using: docker compose --profile dev up)
DEV_PORT=4321

# Domains — single source of truth for both the website, Nginx proxy script, and "Sign In" Hub links.
# Update these anytime you change domains or subdomains in the future.
DOMAIN=gemx.ph
HUB_DOMAIN=hub.gemx.ph
# Optional full URL override (defaults automatically to https://${HUB_DOMAIN}):
# HUB_URL=https://hub.gemx.ph
